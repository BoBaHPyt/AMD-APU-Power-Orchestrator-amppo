# === Rust / Cargo ===
# Папка со скомпилированным кодом и артефактами сборки
/target/

# Локальные файлы конфигурации Cargo (если будете использовать)
.cargo/config.toml

# Лог-файлы паники Cargo
cargo-crash.log

# === Emacs ===
# Временные файлы автосохранения (например, #main.rs#)
\#*\#
.\#*

# Резервные копии файлов, которые Emacs создает при сохранении (например, main.rs~)
*~

# Файлы состояния сессии и истории текстового редактора
/.emacs.desktop
/.emacs.desktop.lock
*.elc
auto-save-list/
tramp/
.directory
.projectile

# === Системные логи вашего демона (на будущее) ===
# Если ваш демон или клиент будут писать локальные лог-файлы для отладки
*.log
